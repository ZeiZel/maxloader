{
  "name": "maxloader",
  "version": "0.1.0",
  "private": true,
  "description": "Sequentially download selected files in MAX",
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "format:check": "node scripts/format-check.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package": "npm run build && npm run verify:dist && node scripts/package.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "e2e:smoke": "npm run build && npx playwright test e2e/extension.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/chrome": "^0.0.274",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "yazl": "3.3.1"
  }
}
